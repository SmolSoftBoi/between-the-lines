# Runtime
APP_ENV=development
PUBLIC_APP_URL=http://localhost:3000
DEPLOYMENT_TARGET=local
RELEASE_SHA=local

# Privacy-first telemetry
# Telemetry must stay disabled until the app has consent, disclosure, and
# retention controls in place.
TELEMETRY_ENABLED=false
TELEMETRY_ENDPOINT=
TELEMETRY_DATASET=between_the_lines_development
TELEMETRY_SAMPLE_RATE=0
TELEMETRY_RETENTION_DAYS=30

# Web client
VITE_TELEMETRY_ENABLED=false
VITE_TELEMETRY_ENDPOINT=

# Privacy controls
# Use a server-side secret in deployed environments; never commit the value.
TELEMETRY_HASH_SALT=
TELEMETRY_HASH_SALT_ROTATION_DAYS=30
TELEMETRY_ALLOW_DEBUG_LOGS=false
